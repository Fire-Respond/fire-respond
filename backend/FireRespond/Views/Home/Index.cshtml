@{
    Layout = null;
}
<!doctype html>
<html lang="id" data-theme="dark">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>FireRespond</title>
    <link rel="icon" href="/img/fr-logo.svg" type="image/svg+xml">
    <link rel="alternate icon" href="/img/favicon.png" type="image/png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Archivo:wdth,wght@62..125,400..800&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.css">
    <link rel="stylesheet" href="/css/dashboard.css">
    <script>
        (function() {
            var saved = localStorage.getItem('fr_theme') || 'dark';
            document.documentElement.setAttribute('data-theme', saved);
        })();
    </script>
</head>
<body>
    <header class="topbar">
        <div class="brand">
            <span class="logo-badge">
                <img src="/img/logo-teks.jpg" alt="FireRespond">
            </span>
        </div>

        <div class="replay">
            <label for="tgl-replay">Putar ulang data satelit</label>
            <input type="date" id="tgl-replay" value="2026-08-21">
            <button id="btn-replay">Putar</button>
            <button id="btn-tarik" class="ghost">Tarik data terbaru</button>
        </div>

        <div class="user">
            <span id="live" class="live" role="status"><i aria-hidden="true"></i><span id="live-teks">Menghubungkan…</span></span>
            <span id="jam" class="jam"></span>
            
            <button id="btn-tema" class="btn-tema" type="button" title="Ganti Mode Terang / Gelap" aria-label="Ganti mode tema">
                <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="5"></circle>
                    <line x1="12" y1="1" x2="12" y2="3"></line>
                    <line x1="12" y1="21" x2="12" y2="23"></line>
                    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                    <line x1="1" y1="12" x2="3" y2="12"></line>
                    <line x1="21" y1="12" x2="23" y2="12"></line>
                    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                </svg>
                <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                </svg>
            </button>

            <div class="user-badge">
                <span class="user-avatar">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                </span>
                <span id="nama-admin" class="nama">Admin BPBD</span>
            </div>

            <button id="btn-keluar" class="ghost">Keluar</button>
        </div>
    </header>

    <section class="kpi" aria-label="Ringkasan">
        <div class="kpi-item" id="kotak-baru">
            <div class="kpi-header">
                <span class="label">Belum direspons</span>
                <span class="kpi-icon icon-danger">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2c1 3 4 5 4 9a6 6 0 1 1-12 0c0-4 3-6 4-9 1 2 2 3 4 0z"/></svg>
                </span>
            </div>
            <strong id="kpi-baru">–</strong>
            <span class="sub">eskalasi otomatis setelah 30 mnt</span>
        </div>
        <div class="kpi-item" id="kotak-eskalasi">
            <div class="kpi-header">
                <span class="label">Butuh bantuan BPBD</span>
                <span class="kpi-icon icon-warning">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                </span>
            </div>
            <strong id="kpi-eskalasi">–</strong>
            <span class="sub" id="sub-eskalasi">eskalasi yang belum dibantu</span>
        </div>
        <div class="kpi-item">
            <div class="kpi-header">
                <span class="label">Tiket aktif</span>
                <span class="kpi-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                </span>
            </div>
            <strong id="kpi-aktif">–</strong>
            <span class="sub" id="sub-aktif">&nbsp;</span>
        </div>
        <div class="kpi-item">
            <div class="kpi-header">
                <span class="label">Rata-rata respons regu</span>
                <span class="kpi-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                </span>
            </div>
            <strong id="kpi-respons">–</strong>
            <span class="sub">batas 30 mnt</span>
        </div>
        <div class="kpi-item">
            <div class="kpi-header">
                <span class="label">Alarm palsu</span>
                <span class="kpi-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
                </span>
            </div>
            <strong id="kpi-palsu">–</strong>
            <span class="sub">dari tiket yang sudah dicek</span>
        </div>
        <div class="kpi-item">
            <div class="kpi-header">
                <span class="label">Luas terbakar</span>
                <span class="kpi-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                </span>
            </div>
            <strong id="kpi-luas">–</strong>
            <span class="sub">total laporan regu</span>
        </div>
    </section>

    <main class="isi">
        <div class="peta-wrap">
            <div id="peta" aria-label="Peta titik panas dan tiket"></div>
            <div class="legenda">
                <span><i class="titik" style="background:#ff3b1f"></i>Titik panas tinggi</span>
                <span><i class="titik" style="background:#ffa21c"></i>Sedang</span>
                <span><i class="bulat" style="background:var(--st-baru)"></i>Baru</span>
                <span><i class="bulat" style="background:var(--st-jalan)"></i>Menuju / dicek</span>
                <span><i class="bulat" style="background:var(--st-tangani)"></i>Penanganan</span>
                <span><i class="bulat" style="background:var(--st-pantau)"></i>Pemantauan</span>
                <span><i class="bulat eskalasi"></i>Minta bantuan</span>
            </div>
        </div>

        <aside class="panel">
            <div id="panel-daftar">
                <div class="panel-head">
                    <div class="baris">
                        <h2>Antrean tiket</h2>
                    </div>
                    <div class="filter" role="group" aria-label="Saring tiket">
                        <button class="chip" data-filter="semua" aria-pressed="true">Semua<b id="n-semua"></b></button>
                        <button class="chip" data-filter="aksi" aria-pressed="false">Perlu tindakan<b id="n-aksi"></b></button>
                        <button class="chip" data-filter="tangani" aria-pressed="false">Penanganan<b id="n-tangani"></b></button>
                        <button class="chip" data-filter="pantau" aria-pressed="false">Pemantauan<b id="n-pantau"></b></button>
                    </div>
                </div>
                <div id="daftar" class="daftar"></div>
            </div>
            <div id="panel-detail" hidden></div>
        </aside>
    </main>

    <div id="toast" class="toast" role="status" aria-live="polite"></div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.js"></script>
    <script src="/js/dashboard.js"></script>
</body>
</html>
