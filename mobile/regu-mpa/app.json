{
  "expo": {
    "name": "Fire Respond Regu",
    "slug": "regu-mpa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.firerespond.regu",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "config": {
        "googleMaps": {
          "apiKey": "TIDAK-DIPAKAI-PETA-MEMAKAI-TILE-ESRI"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lokasi dipakai untuk mencatat posisi regu saat melapor."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Kamera dipakai untuk memotret kondisi api di lapangan."
        }
      ],
      "expo-notifications"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "6416843e-3067-4380-b74a-2b86b5dc951e"
      }
    }
  }
}
